{
  "name": "@thenavidm/threads-mcp-cli",
  "version": "1.0.0",
  "description": "Threads MCP server and CLI for Claude Code and AI agents. 30 tools for posting, chained threads, carousels, replies and reply approvals, insights, keyword search and profile discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "threads-mcp": "dist/index.js",
    "threads-cli": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/threads-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/threads-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "threads",
    "threads-api",
    "meta",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
}
